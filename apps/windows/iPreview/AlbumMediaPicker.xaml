<UserControl x:Class="IPreview.AlbumMediaPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid SizeChanged="PickerSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="174" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="QueueColumn" Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="NavigationRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="NavigationRail" Grid.Row="1" Background="#EDF1FA"
                BorderBrush="#DFE5F1" BorderThickness="0,0,1,0" Padding="12" CornerRadius="10,0,0,10">
            <Grid x:Name="NavigationSelectors" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SecondSelectorColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="Creators" Header="来源与创作者" PlaceholderText="请选择"
                          HorizontalAlignment="Stretch" SelectionChanged="CreatorChanged"
                          AutomationProperties.Name="来源与创作者">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding SourcePath}" AutomationProperties.HelpText="{Binding SourcePath}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="Folders" Grid.Row="1" Header="来源专辑" PlaceholderText="请选择"
                          HorizontalAlignment="Stretch" SelectionChanged="AlbumChanged"
                          DisplayMemberPath="Label" AutomationProperties.Name="来源专辑" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Background="#FAFBFE" RowSpacing="2" Padding="9,8,9,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="3,2,3,6" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="MediaHeading" Text="媒体" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="MediaCount" Foreground="#576375" FontSize="11"
                               Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="SelectAllButton" Grid.Column="1" Content="全选" Click="SelectCurrentAlbum"
                        IsEnabled="False" Padding="9,4" VerticalAlignment="Center"
                        AutomationProperties.Name="全选当前专辑" />
            </Grid>
            <Grid Grid.Row="1">
                <GridView x:Name="Candidates" SelectionMode="Multiple" SelectionChanged="MediaSelectionChanged"
                          SizeChanged="CandidateGridSizeChanged"
                          AutomationProperties.Name="来源媒体">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="128" ItemHeight="108" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="9" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" ToolTipService.ToolTip="{Binding Media.DisplayPath}">
                                <Border Height="76" CornerRadius="8" Background="#E6EBF6">
                                    <Grid>
                                        <FontIcon Glyph="{Binding PlaceholderGlyph}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Foreground="#677997" FontSize="18"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <Image Stretch="UniformToFill" Loaded="ThumbnailLoaded"
                                               DataContextChanged="ThumbnailContextChanged" />
                                        <Border Visibility="{Binding VideoBadge}" Background="#B018202D"
                                                Padding="6,4" Margin="5" CornerRadius="7"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <FontIcon Glyph="&#xE768;" Foreground="White" FontSize="10"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Media.FileName}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel x:Name="CandidateEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Margin="8" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE91B;" FontSize="23" Foreground="#7788A5"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="CandidateStatus" Text="先选择来源或创作者"
                               Foreground="#576375" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="QueuePanel" Grid.Row="1" Grid.Column="2" Background="#F1F4FA"
                BorderBrush="#DFE5F1" BorderThickness="1,0,0,0" Padding="10,10,8,8" CornerRadius="0,10,10,0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StagedHeading" Text="待添加 · 0 项" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                <Grid Grid.Row="1">
                    <ListView x:Name="StagedList" SelectionMode="None" IsItemClickEnabled="False"
                              AutomationProperties.Name="待添加媒体">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDE4F0" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                    <Grid ColumnSpacing="6" ToolTipService.ToolTip="{Binding Media.DisplayPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="39" Height="29" CornerRadius="5" Background="#E1E8F5">
                                            <Image Stretch="UniformToFill" Loaded="ThumbnailLoaded"
                                                   DataContextChanged="ThumbnailContextChanged" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Media.FileName}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Click="RemoveStaged" Width="30" Height="30" Padding="0"
                                                Background="Transparent" BorderThickness="0" CornerRadius="15"
                                                AutomationProperties.Name="{Binding RemoveLabel}"
                                                ToolTipService.ToolTip="从待添加移除">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="QueueEmpty" Text="还没有待添加的媒体" Margin="6,15,6,0"
                               HorizontalAlignment="Center" Foreground="#576375" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
