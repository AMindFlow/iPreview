<UserControl x:Class="IPreview.AlbumMediaPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Creators" Header="来源与创作者" PlaceholderText="请选择"
                      HorizontalAlignment="Stretch" SelectionChanged="CreatorChanged"
                      AutomationProperties.Name="来源与创作者">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding SourcePath}" AutomationProperties.HelpText="{Binding SourcePath}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="Folders" Grid.Column="1" Header="来源专辑" PlaceholderText="请选择"
                      HorizontalAlignment="Stretch" SelectionChanged="AlbumChanged"
                      DisplayMemberPath="Label" AutomationProperties.Name="来源专辑" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="媒体" FontWeight="SemiBold" />
                <Border Grid.Row="1" Background="#F4F5F7" CornerRadius="8">
                    <Grid>
                        <GridView x:Name="Candidates" SelectionMode="Multiple" SelectionChanged="MediaSelectionChanged"
                                  AutomationProperties.Name="来源媒体">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="80" ItemHeight="86" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="2" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="70" Spacing="3" ToolTipService.ToolTip="{Binding Media.DisplayPath}">
                                        <Border Height="51" CornerRadius="5" Background="#E4EAF4">
                                            <Grid>
                                                <TextBlock Text="{Binding Placeholder}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="#576375" FontSize="11" />
                                                <Image Stretch="UniformToFill" Loaded="ThumbnailLoaded"
                                                       DataContextChanged="ThumbnailContextChanged" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Media.FileName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock x:Name="CandidateStatus" Text="先选择来源或创作者"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#576375" TextWrapping="Wrap" Margin="10" />
                    </Grid>
                </Border>
                <Button x:Name="SelectAllButton" Grid.Row="2" Content="全选当前专辑" Click="SelectCurrentAlbum" IsEnabled="False" />
            </Grid>
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StagedHeading" Text="待添加 · 0 项" FontWeight="SemiBold" />
                <ListView x:Name="StagedList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="StagedSelectionChanged" Background="#F4F5F7" CornerRadius="8"
                          AutomationProperties.Name="待添加媒体">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" ToolTipService.ToolTip="{Binding Media.DisplayPath}">
                                <Border Width="28" Height="21" CornerRadius="3" Background="#E4EAF4">
                                    <Image Stretch="UniformToFill" Loaded="ThumbnailLoaded"
                                           DataContextChanged="ThumbnailContextChanged" />
                                </Border>
                                <TextBlock Text="{Binding Media.FileName}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="RemoveStagedButton" Grid.Row="2" Content="移除所选" Click="RemoveStaged" IsEnabled="False" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
