<UserControl x:Class="IPreview.AlbumMediaPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="12,10" CornerRadius="14,14,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Creators" Header="媒体源与创作者" PlaceholderText="请选择" MinWidth="0"
                          HorizontalAlignment="Stretch" SelectionChanged="CreatorChanged"
                          AutomationProperties.Name="媒体源与创作者">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding SourcePath}" AutomationProperties.HelpText="{Binding SourcePath}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="Folders" Grid.Column="1" Header="源专辑" PlaceholderText="请选择" MinWidth="0"
                          HorizontalAlignment="Stretch" SelectionChanged="AlbumChanged"
                          DisplayMemberPath="Label" AutomationProperties.Name="源专辑" />
                <Button x:Name="CandidateSortButton" Grid.Column="2" IsEnabled="False" MinHeight="32" Padding="8,4"
                        CornerRadius="8" VerticalAlignment="Bottom" AutomationProperties.Name="文件排序"
                        ToolTipService.ToolTip="文件排序">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                </Button>
                <Button x:Name="SelectAllButton" Grid.Column="3" Content="全选" Click="SelectCurrentAlbum"
                        IsEnabled="False" MinHeight="32" Padding="10,4" CornerRadius="8" VerticalAlignment="Bottom"
                        AutomationProperties.Name="全选当前专辑" ToolTipService.ToolTip="全选当前专辑" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="AddError" Title="无法添加媒体" Severity="Error" />
            <GridView x:Name="Candidates" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="MediaSelectionChanged"
                      SizeChanged="CandidateGridSizeChanged" AutomationProperties.Name="源媒体">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="152" ItemHeight="116" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="9" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4" ToolTipService.ToolTip="{Binding Media.DisplayPath}">
                            <Border Height="84" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="{Binding PlaceholderGlyph}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <Image Stretch="UniformToFill" Loaded="ThumbnailLoaded"
                                           DataContextChanged="ThumbnailContextChanged" />
                                    <Border Visibility="{Binding VideoBadge}" Background="#B018202D"
                                            Padding="6,4" Margin="5" CornerRadius="7"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE768;" Foreground="White" FontSize="10"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Media.FileName}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="CandidateEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Margin="8" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE91B;" FontSize="23" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="CandidateStatus" Text="先选择媒体源或创作者"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="12,9,12,0" CornerRadius="0,0,14,14">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="96" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StagedHeading" Text="待添加 · 0 项" FontSize="14" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2" />
                <ListView x:Name="StagedList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" Padding="0"
                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="待添加媒体">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="108" Spacing="3" ToolTipService.ToolTip="{Binding Media.DisplayPath}">
                                <Grid Height="49">
                                    <Border CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="{Binding PlaceholderGlyph}" FontSize="15"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                            <Image Stretch="UniformToFill" Loaded="ThumbnailLoaded"
                                                   DataContextChanged="ThumbnailContextChanged" />
                                        </Grid>
                                    </Border>
                                    <Button Click="RemoveStaged" Width="26" Height="26" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                            Background="{ThemeResource ControlSolidFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="13"
                                            AutomationProperties.Name="{Binding RemoveLabel}"
                                            ToolTipService.ToolTip="从待添加移除">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding Media.FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="QueueEmpty" Grid.Row="1" Text="还没有待添加的媒体"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
