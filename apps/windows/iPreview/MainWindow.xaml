<Window x:Class="IPreview.MainWindow" Title="iPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" PointerMoved="AlbumAdjustmentPointerMoved"
          PointerReleased="AlbumAdjustmentPointerReleased" PointerCaptureLost="AlbumAdjustmentPointerInterrupted"
          PointerCanceled="AlbumAdjustmentPointerInterrupted" PointerWheelChanged="AlbumAdjustmentPointerWheelChanged">
        <Grid.Resources>
            <Style x:Key="LibrarySubtleButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="LibraryIconButton" TargetType="Button" BasedOn="{StaticResource LibrarySubtleButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>
            <Style x:Key="LibraryCardStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Padding" Value="2" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </Grid.Resources>
        <ContentControl x:Name="LibraryHost" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="LibraryView" PreviewKeyDown="LibraryKeyDown">
            <Grid.Resources>
                <Style x:Key="ViewModeButton" TargetType="ToggleButton">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="MinWidth" Value="30" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="15" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style x:Key="SidebarEntryStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="9,4" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <DataTemplate x:Key="AlbumCoverChoiceTemplate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="52" Height="38" Stretch="UniformToFill"
                               Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:Key="NavigationEntryTemplate">
                    <Grid ColumnSpacing="9" ToolTipService.ToolTip="{Binding Help}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Sidebar" Width="200" Grid.RowSpan="2" SizeChanged="SidebarSizeChanged"
                  Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer Width="199" Margin="0,32,0,0" HorizontalAlignment="Left"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Padding="12,8,12,20" Spacing="5">
                        <Grid ColumnSpacing="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LibraryHomeButton" Click="GoToLibrary" Style="{StaticResource LibrarySubtleButton}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0"
                                    AutomationProperties.Name="媒体库">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="媒体库" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="ShowGlobalSearch" ToolTipService.ToolTip="全局搜索（Ctrl+Shift+F）"
                                    Style="{StaticResource LibraryIconButton}" AutomationProperties.Name="全局搜索">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                            </Button>
                            <Button x:Name="ThemeButton" Grid.Column="2" Style="{StaticResource LibraryIconButton}">
                                <FontIcon Glyph="&#xE793;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <RadioMenuFlyoutItem x:Name="SystemThemeOption" Text="跟随系统" Tag="Default" Click="ChangeTheme" />
                                        <RadioMenuFlyoutItem x:Name="LightThemeOption" Text="浅色" Tag="Light" Click="ChangeTheme" />
                                        <RadioMenuFlyoutItem x:Name="DarkThemeOption" Text="深色" Tag="Dark" Click="ChangeTheme" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Grid Margin="10,11,0,0" Height="32">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="源" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="AddSourceButton" Click="ChooseSource" HorizontalAlignment="Right"
                                    Style="{StaticResource LibraryIconButton}" AutomationProperties.Name="添加媒体源"
                                    ToolTipService.ToolTip="添加媒体源">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                            </Button>
                        </Grid>
                        <ListView x:Name="SourceNavigation" SelectionMode="Single" IsItemClickEnabled="True"
                                  IsMultiSelectCheckBoxEnabled="False" ItemClick="Navigate" PreviewKeyDown="NavigationListKeyDown"
                                  ItemContainerStyle="{StaticResource SidebarEntryStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="源">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Loaded="SourceRowLoaded" Unloaded="SourceRowUnloaded" Background="Transparent"
                                          PointerWheelChanged="SourceRowWheelChanged" MinHeight="26">
                                        <ContentControl x:Name="SourceDescription" Content="{Binding}"
                                                        ContentTemplate="{StaticResource NavigationEntryTemplate}"
                                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                        IsTabStop="False" />
                                        <StackPanel x:Name="SourceActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Visibility="Collapsed">
                                            <Button Style="{StaticResource LibraryIconButton}" Click="RescanSidebarSource"
                                                    AutomationProperties.Name="重新扫描" ToolTipService.ToolTip="重新扫描">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource LibraryIconButton}" Click="DeleteSidebarSource"
                                                    AutomationProperties.Name="删除媒体源" ToolTipService.ToolTip="删除媒体源">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Margin="10,11,0,0" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="合集" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="CreateAlbumButton" Grid.Column="1" Click="CreateAlbum"
                                    Style="{StaticResource LibraryIconButton}" AutomationProperties.Name="新建合集"
                                    ToolTipService.ToolTip="新建合集">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                            </Button>
                        </Grid>
                        <ListView x:Name="AlbumNavigation" SelectionMode="Single" IsItemClickEnabled="True"
                                  IsMultiSelectCheckBoxEnabled="False" ItemClick="Navigate" PreviewKeyDown="NavigationListKeyDown"
                                  ItemTemplate="{StaticResource NavigationEntryTemplate}" ItemContainerStyle="{StaticResource SidebarEntryStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="合集" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent" Height="32"
                  Loaded="TitleBarLoaded" SizeChanged="TitleBarSizeChanged" />
            <StackPanel x:Name="SidebarTools" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="SidebarToolsOffset" X="112" />
                </StackPanel.RenderTransform>
                <Button x:Name="SidebarToggleButton" Click="ToggleSidebar" Style="{StaticResource LibraryIconButton}"
                        AutomationProperties.Name="收起侧边栏" ToolTipService.ToolTip="收起侧边栏">
                    <Grid Width="16" Height="12">
                        <Border BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1.25" CornerRadius="2.5" />
                        <Rectangle x:Name="SidebarToggleDivider" Width="1.25" Height="12" RadiusX="0.625" RadiusY="0.625"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4.5,0,0,0"
                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="ImportButton" Click="ChooseSource" Style="{StaticResource LibraryIconButton}"
                        AutomationProperties.Name="导入文件夹" ToolTipService.ToolTip="导入媒体文件夹">
                    <Grid Width="20" Height="18">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <FontIcon Glyph="&#xE710;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,12,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid RowSpacing="11" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackToSourceFolder" Click="GoBackToSourceFolder" Visibility="Collapsed"
                                Style="{StaticResource LibraryIconButton}" Margin="0,0,6,0"
                                AutomationProperties.Name="返回上一层" ToolTipService.ToolTip="返回上一层">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="Heading" Text="媒体库" FontSize="28" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level1" DoubleTapped="BeginTitleEdit" />
                            <TextBox x:Name="TitleEditor" Visibility="Collapsed" HorizontalAlignment="Stretch"
                                     FontSize="21" MinWidth="0" MaxWidth="350" MaxLength="255"
                                     PreviewKeyDown="TitleEditorKeyDown" AutomationProperties.Name="名称"
                                     TextCompositionStarted="TextCompositionStarted" TextCompositionEnded="TextCompositionEnded" />
                        </Grid>
                        <Border x:Name="SourceAlbumCover" Grid.Column="2" Width="62" Height="42"
                                Margin="8,0,0,0" CornerRadius="6" Visibility="Collapsed"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="10" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CountLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="Rescan" Grid.Column="1" Style="{StaticResource LibrarySubtleButton}"
                                Visibility="Collapsed" Click="RescanSources" Padding="5,0" MinHeight="26">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="重新扫描" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="BrowseTools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OrganizeSourceAlbum" Content="专辑组织" Click="OpenSourceAlbumOrganization"
                                    Style="{StaticResource LibrarySubtleButton}" Visibility="Collapsed" />
                            <Button x:Name="ManageAlbumTags" Content="管理标签" Click="OpenGlobalTagManagement"
                                    Style="{StaticResource LibrarySubtleButton}" Visibility="Collapsed" />
                            <Button x:Name="BrowserSortButton" Style="{StaticResource LibraryIconButton}" Visibility="Collapsed"
                                    AutomationProperties.Name="文件排序" ToolTipService.ToolTip="文件排序">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                            </Button>
                            <Button x:Name="PreviewWorkButton" Click="PreviewCurrentWork" Visibility="Collapsed"
                                    Style="{StaticResource LibrarySubtleButton}" Content="预览作品"
                                    MinHeight="26" FontSize="12" Padding="7,0" />
                            <StackPanel x:Name="AlbumTools" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <Button x:Name="DeleteAlbumButton" Click="DeleteAlbum" Style="{StaticResource LibraryIconButton}"
                                        AutomationProperties.Name="删除合集" ToolTipService.ToolTip="删除合集">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                                <Button x:Name="AlbumPickerButton" Click="PickAlbumMedia" Style="{StaticResource LibraryIconButton}"
                                        AutomationProperties.Name="添加媒体" ToolTipService.ToolTip="添加媒体" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                                <Button x:Name="SelectAlbumMembersButton" Click="BeginAlbumSelection" Content="调整"
                                        CornerRadius="7" MinHeight="26" Padding="10,1" FontSize="12"
                                        ToolTipService.ToolTip="勾选媒体或按住媒体拖动排序" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="AlbumSelectionTools" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="AlbumSelectionCount" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Click="CancelAlbumSelection" Style="{StaticResource LibrarySubtleButton}" Content="取消"
                                    MinHeight="26" FontSize="12" Padding="5,0" />
                            <Button x:Name="RemoveAlbumSelectionButton" Click="RemoveFromAlbum" Content="移除引用"
                                    CornerRadius="7" MinHeight="26" FontSize="12" Padding="9,1" IsEnabled="False" />
                        </StackPanel>
                        <Border Grid.Column="3" CornerRadius="19" Padding="6,3" Height="38" VerticalAlignment="Center"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Visibility, ElementName=ViewModePicker}">
                            <StackPanel x:Name="ViewModePicker" Orientation="Horizontal" Spacing="8"
                                        AutomationProperties.Name="浏览视图">
                                <StackPanel.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Default">
                                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlAltFillColorQuarternaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlAltFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlAltFillColorQuarternaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlAltFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast">
                                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SystemControlHighlightAccentBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SystemColorButtonTextColorBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemControlHighlightAltChromeWhiteBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemColorButtonFaceColorBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SystemColorHighlightColorBrush" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </StackPanel.Resources>
                                <ToggleButton x:Name="ListModeButton" Click="ChangeBrowseMode"
                                              Style="{StaticResource ViewModeButton}" AutomationProperties.Name="列表"
                                              ToolTipService.ToolTip="列表（Ctrl+1）">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="GalleryModeButton" Click="ChangeBrowseMode"
                                              Style="{StaticResource ViewModeButton}" AutomationProperties.Name="画廊"
                                              ToolTipService.ToolTip="画廊（Ctrl+2）">
                                    <FontIcon Glyph="&#xE91B;" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="IconModeButton" Click="ChangeBrowseMode"
                                              Style="{StaticResource ViewModeButton}" AutomationProperties.Name="图标"
                                              ToolTipService.ToolTip="图标（Ctrl+3）">
                                    <FontIcon Glyph="&#xE8A9;" FontSize="13" />
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <InfoBar x:Name="Notice" Grid.Row="1" IsClosable="True" />
                <Grid Grid.Row="2">
                    <Grid.Resources>
                        <DataTemplate x:Key="AlbumSelectionMark">
                            <Border Width="17" Height="17" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>
                    <GridView x:Name="Gallery" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                              DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                              SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体项目"
                              SizeChanged="CardGridSizeChanged" ContainerContentChanging="CardContainerChanging"
                              ItemContainerStyle="{StaticResource LibraryCardStyle}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="180" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="5" ToolTipService.ToolTip="{Binding DisplayPath}" Background="Transparent"
                                      PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="12">
                                        <Grid>
                                            <Image Stretch="UniformToFill" Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                                            <Border Visibility="{Binding BadgeVisibility}" Background="#B018202D"
                                                    Padding="7,3" CornerRadius="8" Margin="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" />
                                            </Border>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AlbumSelectionMark}"
                                                            Visibility="{Binding AlbumRemovalTickVisibility}" IsHitTestVisible="False"
                                                            IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="12"
                                               Margin="4,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Grid x:Name="DetailsPane" Visibility="Collapsed">
                        <Grid.Resources>
                            <GridLength x:Key="DetailNameWidth">5*</GridLength>
                            <GridLength x:Key="DetailModifiedWidth">2.4*</GridLength>
                            <GridLength x:Key="DetailSizeWidth">1.1*</GridLength>
                            <GridLength x:Key="DetailKindWidth">1.6*</GridLength>
                            <GridLength x:Key="DetailSelectionWidth">17</GridLength>
                            <x:Double x:Key="DetailModifiedMaximum">178</x:Double>
                            <x:Double x:Key="DetailSizeMaximum">98</x:Double>
                            <x:Double x:Key="DetailKindMaximum">128</x:Double>
                            <Thickness x:Key="DetailRowPadding">10,0,12,0</Thickness>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="8,8,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid Padding="{StaticResource DetailRowPadding}" MinHeight="32" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource DetailNameWidth}" />
                                    <ColumnDefinition Width="{StaticResource DetailModifiedWidth}" MaxWidth="{StaticResource DetailModifiedMaximum}" />
                                    <ColumnDefinition Width="{StaticResource DetailSizeWidth}" MaxWidth="{StaticResource DetailSizeMaximum}" />
                                    <ColumnDefinition Width="{StaticResource DetailKindWidth}" MaxWidth="{StaticResource DetailKindMaximum}" />
                                    <ColumnDefinition Width="{StaticResource DetailSelectionWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" Margin="30,0,0,0" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="修改日期" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="大小" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="种类" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <!-- ListView navigation scrolls to the row itself. Skip the ScrollViewer's extra focus margin. -->
                        <ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                                  SingleSelectionFollowsFocus="True"
                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体列表"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="29" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{StaticResource DetailRowPadding}" MinHeight="29" ColumnSpacing="10" CornerRadius="6"
                                          Background="{Binding RowBackground}" ToolTipService.ToolTip="{Binding DisplayPath}"
                                          Loaded="LoadListDetails" DataContextChanged="UpdateListDetails"
                                          PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource DetailNameWidth}" />
                                            <ColumnDefinition Width="{StaticResource DetailModifiedWidth}" MaxWidth="{StaticResource DetailModifiedMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailSizeWidth}" MaxWidth="{StaticResource DetailSizeMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailKindWidth}" MaxWidth="{StaticResource DetailKindMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailSelectionWidth}" />
