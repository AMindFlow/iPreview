<Window x:Class="IPreview.MainWindow" Title="iPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" PointerMoved="AlbumAdjustmentPointerMoved"
          PointerReleased="AlbumAdjustmentPointerReleased" PointerCaptureLost="AlbumAdjustmentPointerInterrupted"
          PointerCanceled="AlbumAdjustmentPointerInterrupted" PointerWheelChanged="AlbumAdjustmentPointerWheelChanged">
        <ContentControl x:Name="LibraryHost" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="LibraryView" PreviewKeyDown="LibraryKeyDown">
            <Grid.Resources>
                <Style x:Key="LibrarySubtleButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="LibraryIconButton" TargetType="Button" BasedOn="{StaticResource LibrarySubtleButton}">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="MinWidth" Value="32" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="198" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Padding="12,16,12,14" RowSpacing="12"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LibraryHomeButton" Click="GoToLibrary" Style="{StaticResource LibrarySubtleButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0"
                            AutomationProperties.Name="媒体库">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="媒体库" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="ShowGlobalSearch" ToolTipService.ToolTip="全局搜索（Ctrl+Shift+F）"
                            Style="{StaticResource LibraryIconButton}" AutomationProperties.Name="全局搜索">
                        <FontIcon Glyph="&#xE721;" FontSize="15" />
                    </Button>
                </Grid>
                <TreeView x:Name="NavTree" Grid.Row="1" SelectionMode="Single" ItemInvoked="Navigate"
                          PreviewKeyDown="NavigationTreeKeyDown">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Text="{Binding Content.Label}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <StackPanel Grid.Row="2" Spacing="3">
                    <Border Height="1" Margin="0,0,0,3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Name="CreateAlbumButton" Click="CreateAlbum" Style="{StaticResource LibrarySubtleButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0"
                            AutomationProperties.Name="新建虚拟专辑">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="新建专辑" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="Rescan" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0"
                            Style="{StaticResource LibrarySubtleButton}" Click="RescanSources">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="重新扫描" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="22,16,22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid RowSpacing="8" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" MaxWidth="310" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BackToSourceFolder" Click="GoBackToSourceFolder" Visibility="Collapsed"
                                    Style="{StaticResource LibraryIconButton}" Margin="0,0,4,0"
                                    AutomationProperties.Name="返回上一层" ToolTipService.ToolTip="返回上一层">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" />
                            </Button>
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="Heading" Text="媒体库" FontSize="28" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           AutomationProperties.HeadingLevel="Level1" DoubleTapped="BeginTitleEdit" />
                                <TextBox x:Name="TitleEditor" Visibility="Collapsed" HorizontalAlignment="Stretch"
                                         FontSize="21" MinWidth="0" MaxWidth="350" MaxLength="255"
                                         PreviewKeyDown="TitleEditorKeyDown" AutomationProperties.Name="名称"
                                         TextCompositionStarted="TextCompositionStarted" TextCompositionEnded="TextCompositionEnded" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="Query" MinWidth="0" QueryIcon="Find" PlaceholderText="搜索当前范围"
                                            GettingFocus="ObserveScopedSearchFocus" ToolTipService.ToolTip="搜索当前范围（Ctrl+F）"
                                            QuerySubmitted="SearchSubmitted" TextChanged="SearchEdited" AutomationProperties.Name="搜索当前范围" />
                            <Button x:Name="SearchOptions" Grid.Column="1" Style="{StaticResource LibraryIconButton}"
                                    ToolTipService.ToolTip="搜索选项" AutomationProperties.Name="搜索选项">
                                <FontIcon Glyph="&#xE71C;" FontSize="15" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="9" MinWidth="150">
                                            <ComboBox x:Name="SearchMode" SelectedIndex="1" SelectionChanged="ChangeSearchMode"
                                                      AutomationProperties.Name="搜索精确度" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="精确" />
                                                <ComboBoxItem Content="模糊" />
                                            </ComboBox>
                                            <CheckBox x:Name="SearchFolders" Content="目录" IsChecked="True" Click="ChangeSearchScope" />
                                            <CheckBox x:Name="SearchFiles" Content="文件" IsChecked="True" Click="ChangeSearchScope" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CountLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="ImportButton" Grid.Column="1" Click="ChooseSource"
                                Style="{StaticResource LibrarySubtleButton}" AutomationProperties.Name="导入文件夹">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="导入" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="2" CornerRadius="9" Padding="2,0"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Visibility, ElementName=ViewModePicker}">
                            <SelectorBar x:Name="ViewModePicker" SelectionChanged="ChangeBrowseMode"
                                         AutomationProperties.Name="浏览视图">
                                <SelectorBarItem IsSelected="True" AutomationProperties.Name="图标" ToolTipService.ToolTip="图标">
                                    <SelectorBarItem.Icon>
                                        <FontIcon Glyph="&#xE8A9;" FontSize="15" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem AutomationProperties.Name="列表" ToolTipService.ToolTip="列表">
                                    <SelectorBarItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem AutomationProperties.Name="画廊" ToolTipService.ToolTip="画廊">
                                    <SelectorBarItem.Icon>
                                        <FontIcon Glyph="&#xE91B;" FontSize="15" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                            </SelectorBar>
                        </Border>
                    </Grid>
                </Grid>

                <InfoBar x:Name="Notice" Grid.Row="1" IsClosable="True" />
                <Grid Grid.Row="2">
                    <Grid.Resources>
                        <DataTemplate x:Key="AlbumSelectionMark">
                            <Border Width="17" Height="17" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>
                    <GridView x:Name="Gallery" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                              DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                              SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体项目">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Padding" Value="5" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="274" ItemHeight="207" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="256" Height="193" RowSpacing="5" ToolTipService.ToolTip="{Binding DisplayPath}" Background="Transparent"
                                      PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="168" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="12">
                                        <Grid>
                                            <Image Stretch="UniformToFill" Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                                            <Border Visibility="{Binding BadgeVisibility}" Background="#B018202D"
                                                    Padding="7,3" CornerRadius="8" Margin="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" />
                                            </Border>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AlbumSelectionMark}"
                                                            Visibility="{Binding AlbumRemovalTickVisibility}" IsHitTestVisible="False"
                                                            IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="12"
                                               Margin="4,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Grid x:Name="DetailsPane" Visibility="Collapsed">
                        <Grid.Resources>
                            <GridLength x:Key="DetailNameWidth">5*</GridLength>
                            <GridLength x:Key="DetailModifiedWidth">2.4*</GridLength>
                            <GridLength x:Key="DetailSizeWidth">1.1*</GridLength>
                            <GridLength x:Key="DetailKindWidth">1.6*</GridLength>
                            <GridLength x:Key="DetailSelectionWidth">17</GridLength>
                            <x:Double x:Key="DetailModifiedMaximum">178</x:Double>
                            <x:Double x:Key="DetailSizeMaximum">98</x:Double>
                            <x:Double x:Key="DetailKindMaximum">128</x:Double>
                            <Thickness x:Key="DetailRowPadding">10,0,12,0</Thickness>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="8,8,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid Padding="{StaticResource DetailRowPadding}" MinHeight="32" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource DetailNameWidth}" />
                                    <ColumnDefinition Width="{StaticResource DetailModifiedWidth}" MaxWidth="{StaticResource DetailModifiedMaximum}" />
                                    <ColumnDefinition Width="{StaticResource DetailSizeWidth}" MaxWidth="{StaticResource DetailSizeMaximum}" />
                                    <ColumnDefinition Width="{StaticResource DetailKindWidth}" MaxWidth="{StaticResource DetailKindMaximum}" />
                                    <ColumnDefinition Width="{StaticResource DetailSelectionWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" Margin="30,0,0,0" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="修改日期" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="大小" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="种类" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                                  SingleSelectionFollowsFocus="True"
                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体列表"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="29" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{StaticResource DetailRowPadding}" MinHeight="29" ColumnSpacing="10" CornerRadius="6"
                                          Background="{Binding RowBackground}" ToolTipService.ToolTip="{Binding DisplayPath}"
                                          Loaded="LoadListDetails" DataContextChanged="UpdateListDetails"
                                          PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource DetailNameWidth}" />
                                            <ColumnDefinition Width="{StaticResource DetailModifiedWidth}" MaxWidth="{StaticResource DetailModifiedMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailSizeWidth}" MaxWidth="{StaticResource DetailSizeMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailKindWidth}" MaxWidth="{StaticResource DetailKindMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailSelectionWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="18" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="3">
                                                <Image Stretch="UniformToFill" Loaded="LoadThumbnail"
                                                       DataContextChanged="UpdateThumbnail" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Details.Modified}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details.Size}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource AlbumSelectionMark}"
                                                        Visibility="{Binding AlbumRemovalTickVisibility}" IsHitTestVisible="False"
                                                        IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid x:Name="FilmstripPane" Visibility="Collapsed" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Image x:Name="FilmstripImage" Stretch="Uniform" />
                                <TextBlock x:Name="FilmstripMessage" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ListView x:Name="Filmstrip" Grid.Row="1" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                                  SingleSelectionFollowsFocus="True"
                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="画廊缩略图"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="0,0,2,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="88" RowSpacing="3" ToolTipService.ToolTip="{Binding DisplayPath}" Background="Transparent"
                                          PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="58" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="5">
                                            <Grid>
                                                <Image Stretch="UniformToFill" Loaded="LoadThumbnail"
                                                       DataContextChanged="UpdateThumbnail" />
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AlbumSelectionMark}"
                                                                Visibility="{Binding AlbumRemovalTickVisibility}" IsHitTestVisible="False"
                                                                IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <ListView x:Name="SourceFolders" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OpenSourceFolder"
                              PreviewKeyDown="SourceFoldersKeyDown"
                              AutomationProperties.Name="创作者与专辑">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="2,6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{Binding Label}" FontSize="14" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyAlbumPicker" Visibility="Collapsed" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="EmptyAlbumAddButton" Click="PickAlbumMedia" AutomationProperties.Name="添加媒体"
                                ToolTipService.ToolTip="添加媒体" Style="{StaticResource LibrarySubtleButton}"
                                HorizontalAlignment="Center" Padding="4">
                            <Grid Width="66" Height="66">
                                <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Width="25" Height="25" CornerRadius="13" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                        <TextBlock Text="专辑为空" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyLabel" Text="导入文件夹后，图片和视频会显示在这里。"
                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Canvas x:Name="AlbumDragLayer" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                        <Rectangle x:Name="AlbumDropPlaceholder" RadiusX="7" RadiusY="7" Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                   Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="5,4" Visibility="Collapsed" />
                        <Border x:Name="AlbumDragAvatar" CornerRadius="7" BorderThickness="1"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                Opacity="0.96" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="AlbumDragCaption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="10,0" TextTrimming="CharacterEllipsis" />
                                <Image x:Name="AlbumDragImage" Stretch="Fill" />
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Grid x:Name="BrowseTools" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenButton" Click="PreviewSelected" Style="{StaticResource LibrarySubtleButton}"
                                    AutomationProperties.Name="预览">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8FF;" FontSize="15" />
                                    <TextBlock Text="预览" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="AlbumTools" Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <Button x:Name="AlbumPickerButton" Click="PickAlbumMedia" Style="{StaticResource LibraryIconButton}"
                                        AutomationProperties.Name="添加媒体" ToolTipService.ToolTip="添加媒体" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                                </Button>
                                <Button x:Name="SelectAlbumMembersButton" Click="BeginAlbumSelection" Content="调整"
                                        CornerRadius="8" MinHeight="32" ToolTipService.ToolTip="勾选媒体或按住媒体拖动排序"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="AlbumSelectionTools" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlbumSelectionCount" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Click="CancelAlbumSelection" Style="{StaticResource LibrarySubtleButton}" Content="取消" />
                                <Button x:Name="RemoveAlbumSelectionButton" Click="RemoveFromAlbum" Content="移除引用"
                                        CornerRadius="8" MinHeight="32" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ContentControl>

        <Grid x:Name="GlobalSearchOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle"
              PreviewKeyDown="GlobalSearchKeyDown" AutomationProperties.Name="全局搜索">
            <Border Background="#2E000000" Tapped="DismissGlobalSearchFromBackdrop" />
            <Border MaxWidth="585" Margin="22" VerticalAlignment="Center" CornerRadius="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <StackPanel Spacing="8" Padding="17,13,17,12">
                    <Grid ColumnSpacing="9" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="GlobalSearchInput" Grid.Column="1" PlaceholderText="搜索所有来源"
                                 AutomationProperties.Name="搜索所有来源" VerticalAlignment="Center" MinWidth="0"
                                 FontSize="21" Padding="0,4" BorderThickness="0" Background="Transparent"
                                 TextChanged="GlobalSearchEdited" TextCompositionStarted="TextCompositionStarted"
                                 TextCompositionEnded="TextCompositionEnded" />
                        <Border x:Name="GlobalSearchExactBadge" Grid.Column="2" Visibility="Collapsed"
                                VerticalAlignment="Center" CornerRadius="12" Padding="9,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="精确匹配" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <Button Grid.Column="3" Click="CloseGlobalSearchButton" ToolTipService.ToolTip="关闭全局搜索（Esc）"
                                VerticalAlignment="Center" Width="32" Height="32" Padding="0" CornerRadius="12"
                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="关闭全局搜索">
                            <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="GlobalSearchStatus" Visibility="Collapsed" Margin="3,3,0,3"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ListView x:Name="GlobalSearchResults" Visibility="Collapsed" MaxHeight="299" SelectionMode="Single"
                              SingleSelectionFollowsFocus="True" AutomationProperties.Name="全局搜索结果">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="9" MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Location}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="GlobalFileScope" Content="Ctrl+1 文件" Click="GlobalScopeClicked"
                                          CornerRadius="12" MinHeight="28" Padding="8,3"
                                          AutomationProperties.Name="仅搜索文件">
                                <ToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="GlobalScopeShortcut" />
                                </ToggleButton.KeyboardAccelerators>
                            </ToggleButton>
                            <ToggleButton x:Name="GlobalDirectoryScope" Grid.Column="1" Content="Ctrl+2 目录"
                                          CornerRadius="12" MinHeight="28" Padding="8,3"
                                          Click="GlobalScopeClicked" AutomationProperties.Name="仅搜索目录">
                                <ToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="GlobalScopeShortcut" />
                                </ToggleButton.KeyboardAccelerators>
                            </ToggleButton>
                            <TextBlock Grid.Column="2" Text="输入 @ 后按空格精确匹配"
                                       FontSize="12" Margin="6,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="↑ / ↓ 选择    Enter 前往    Space 预览    Esc 关闭"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="PreviewOverlay" Visibility="Collapsed" Background="Transparent" RequestedTheme="Dark"
              PreviewKeyDown="PreviewKeyDown" TabFocusNavigation="Cycle">
            <Grid.Resources>
                <Style x:Key="PreviewFlatButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="44" />
                    <Setter Property="MinHeight" Value="36" />
                </Style>
            </Grid.Resources>
            <Border x:Name="PreviewBackdrop" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    IsHitTestVisible="False" />
            <Grid x:Name="PreviewContent" Padding="10,4,10,8" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid MinHeight="40">
                    <Button Click="ClosePreviewButton" Style="{StaticResource PreviewFlatButton}" HorizontalAlignment="Left"
                            AutomationProperties.Name="退出预览" ToolTipService.ToolTip="退出预览（Esc）">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>
                    <TextBlock x:Name="PreviewTitle" Margin="52,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </Grid>

                <ContentControl x:Name="PreviewCanvas" Grid.Row="1" IsTabStop="True"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="预览画布">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PreviewTopRail" Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="PreviewBottomRail" Height="36" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PreviewLeftRail" Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PreviewRightRail" Width="44" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="NeighborTop" Grid.Column="1" Width="72" Height="28" Opacity=".20" Stretch="UniformToFill" />
                        <Image x:Name="NeighborLeft" Grid.Row="1" Width="32" Height="72" Opacity=".20" Stretch="UniformToFill" />
                        <Image x:Name="NeighborRight" Grid.Row="1" Grid.Column="2" Width="32" Height="72"
                               Opacity=".20" Stretch="UniformToFill" />
                        <Image x:Name="NeighborBottom" Grid.Row="2" Grid.Column="1" Width="72" Height="28"
                               Opacity=".20" Stretch="UniformToFill" />
                        <Border x:Name="PreviewStage" Grid.Row="1" Grid.Column="1" Background="#0C1317" CornerRadius="8">
                            <Grid>
                                <Image x:Name="MainImage" Stretch="Uniform" />
                                <MediaPlayerElement x:Name="VideoSurface" Visibility="Collapsed" AreTransportControlsEnabled="False"
                                                    IsTabStop="False" IsHitTestVisible="False" Stretch="Uniform" />
                                <TextBlock x:Name="PreviewError" Visibility="Collapsed" Foreground="#F0CEAE"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="22" />
                            </Grid>
                        </Border>
                        <Button x:Name="PreviewUp" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="MovePreviewUp" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向上切换媒体">
                            <FontIcon Glyph="&#xE70E;" FontSize="18" />
                        </Button>
                        <Button x:Name="PreviewLeft" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="MovePreviewLeft" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向左切换媒体">
                            <FontIcon Glyph="&#xE76B;" FontSize="18" />
                        </Button>
                        <Button x:Name="PreviewRight" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="MovePreviewRight" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向右切换媒体">
                            <FontIcon Glyph="&#xE76C;" FontSize="18" />
                        </Button>
                        <Button x:Name="PreviewDown" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="MovePreviewDown" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向下切换媒体">
                            <FontIcon Glyph="&#xE70D;" FontSize="18" />
                        </Button>
                    </Grid>
                </ContentControl>

                <StackPanel Grid.Row="2" Spacing="3">
                    <ContentControl x:Name="VideoControls" Visibility="Collapsed" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" MaxWidth="680">
                        <Grid Background="#253034" CornerRadius="20" Padding="10,3" ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VideoBack" Content="−15 秒" Click="SeekVideoBack" Style="{StaticResource PreviewFlatButton}"
                                    AutomationProperties.Name="后退 15 秒" />
                            <Button x:Name="PlayPause" Grid.Column="1" Content="播放" Click="TogglePlayback"
                                    Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="播放或暂停" />
                            <Button x:Name="VideoForward" Grid.Column="2" Content="+15 秒" Click="SeekVideoForward"
                                    Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="前进 15 秒" />
                            <TextBlock x:Name="TimeLabel" Grid.Column="3" VerticalAlignment="Center" Foreground="#D2DEDE" />
                            <Slider x:Name="Timeline" Grid.Column="4" Minimum="0" Maximum="1" StepFrequency=".25"
                                    VerticalAlignment="Center" ValueChanged="Seek" AutomationProperties.Name="视频进度" />
                            <TextBlock x:Name="DurationLabel" Grid.Column="5" VerticalAlignment="Center" Foreground="#D2DEDE" />
                            <ToggleButton x:Name="VideoLock" Grid.Column="6" Click="ToggleVideoLock"
                                          Content="未锁定" AutomationProperties.Name="锁定视频预览"
                                          ToolTipService.ToolTip="锁定或解锁视频预览（Enter）" />
                        </Grid>
                    </ContentControl>
                    <Grid>
                        <TextBlock x:Name="PreviewHint" Foreground="#BCCBCB" Margin="65,0" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock x:Name="IndexLabel" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#B6C4C5" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Canvas x:Name="PreviewMotionLayer" Visibility="Collapsed" IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw">
                <Image x:Name="PreviewMotionImage" Stretch="Uniform" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
