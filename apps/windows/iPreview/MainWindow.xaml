                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="9" MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="SearchFiles" Content="Ctrl+1 文件" Click="ResultKindClicked"
                                          CornerRadius="12" MinHeight="28" Padding="8,3"
                                          AutomationProperties.Name="仅搜索文件">
                                <ToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="ResultKindShortcut" />
                                </ToggleButton.KeyboardAccelerators>
                            </ToggleButton>
                            <ToggleButton x:Name="SearchDirectories" Grid.Column="1" Content="Ctrl+2 目录"
                                          CornerRadius="12" MinHeight="28" Padding="8,3"
                                          Click="ResultKindClicked" AutomationProperties.Name="仅搜索目录">
                                <ToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="ResultKindShortcut" />
                                </ToggleButton.KeyboardAccelerators>
                            </ToggleButton>
                            <Button x:Name="SearchDomain" Grid.Column="2" Content="Ctrl+0 全局"
                                    CornerRadius="12" MinHeight="28" Padding="8,3" Click="SwitchSearchDomainClick"
                                    AutomationProperties.Name="切换搜索范围">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="SwitchSearchDomainShortcut" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <TextBlock x:Name="SearchExactHint" Grid.Column="3" Text="输入 # 搜索标签 · @ 后按空格精确匹配"
                                       FontSize="12" Margin="6,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="SearchKeyHelp"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="VideoWorkOverlay" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="24,18"
              PreviewKeyDown="VideoWorkKeyDown" TabFocusNavigation="Cycle" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="VideoWorkHeader" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Click="BackFromVideoWork" Style="{StaticResource LibraryIconButton}"
                        AutomationProperties.Name="退出专辑模式" ToolTipService.ToolTip="退出专辑模式（Esc）">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
                <TextBlock x:Name="VideoWorkTitle" Grid.Column="1" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="VideoWorkTape" Click="VideoWorkTapeClicked" Padding="8"
                        Style="{StaticResource LibrarySubtleButton}" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="216"
                        AutomationProperties.Name="录像带">
                    <StackPanel Spacing="10">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="272"
                                 AutomationProperties.AccessibilityView="Raw">
                            <Grid Width="153" Height="272">
                                <Border Margin="3,3,0,0" CornerRadius="14"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                <Border Margin="0,0,3,3" CornerRadius="14"
                                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Border Margin="12,12,12,12" CornerRadius="10"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"
                                                    VerticalAlignment="Bottom" Margin="0,0,0,27">
                                            <Ellipse Width="36" Height="36" Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="3" />
                                            <Ellipse Width="36" Height="36" Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="3" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="VideoWorkTapeLid" Margin="0,0,3,3" CornerRadius="14"
                                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Border Width="10" HorizontalAlignment="Left" Margin="4,9,0,9" CornerRadius="4"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Border Height="1" VerticalAlignment="Top" Margin="18,9,12,0" Background="#74FFFFFF" />
                                        <Border Height="10" Width="86" CornerRadius="4" Margin="0,29,0,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Border Width="116" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE714;" FontSize="24"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Image x:Name="VideoWorkTapeCover" Stretch="Uniform"
                                                       Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="20,0,20,28" Height="34" VerticalAlignment="Bottom" CornerRadius="7"
                                                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Spacing="25">
                                                <Ellipse Width="14" Height="14" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="2" />
                                                <Ellipse Width="14" Height="14" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="2" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="录像带" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <GridView x:Name="VideoWorkItems" Grid.Column="1" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                          IsItemClickEnabled="True" ItemClick="VideoWorkItemClicked"
                          SizeChanged="VideoWorkBooksSizeChanged" AutomationProperties.Name="作品图册">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource LibraryCardStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="157" ItemHeight="218" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="7,8,7,0" Spacing="7">
                                <Grid Height="178" AutomationProperties.AccessibilityView="Raw">
                                    <Grid.Projection>
                                        <PlaneProjection RotationY="-6" RotationX="2" />
                                    </Grid.Projection>
                                    <Border Margin="16,12,0,0" CornerRadius="8"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    <Border Margin="10,7,6,6" CornerRadius="8"
                                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,7,4" Spacing="2">
                                        <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                    </StackPanel>
                                    <Border Margin="0,0,12,12" CornerRadius="8,5,5,8"
                                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Border Width="7" HorizontalAlignment="Left" Margin="2,5,0,5" CornerRadius="3"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            <Border Margin="13,11,8,22" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE91B;" FontSize="22"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image DataContext="{Binding Cover}" Stretch="UniformToFill"
                                                           Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                                                </Grid>
                                            </Border>
                                            <Border Height="1" VerticalAlignment="Bottom" Margin="14,0,9,8" Background="#60FFFFFF" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <Grid x:Name="PreviewOverlay" Visibility="Collapsed" Background="Transparent"
              PreviewKeyDown="PreviewKeyDown" TabFocusNavigation="Cycle">
            <Grid.Resources>
                <LinearGradientBrush x:Key="WorkAuraBrush" StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform CenterX=".5" CenterY=".5" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Offset="0" Color="#FF52BEF5" />
                    <GradientStop Offset=".28" Color="#FF57E5C6" />
                    <GradientStop Offset=".56" Color="#FFF0C886" />
                    <GradientStop Offset=".82" Color="#FFC178EF" />
                    <GradientStop Offset="1" Color="#FF60AFE3" />
                </LinearGradientBrush>
                <Style x:Key="PreviewFlatButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="44" />
                    <Setter Property="MinHeight" Value="36" />
                </Style>
            </Grid.Resources>
            <Border x:Name="PreviewBackdrop" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    IsHitTestVisible="False" />
            <Grid x:Name="PreviewContent" Padding="10,4,10,8" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid MinHeight="40">
                    <Button x:Name="PreviewCloseAction" Click="ClosePreviewButton" Style="{StaticResource PreviewFlatButton}" HorizontalAlignment="Left"
                            AutomationProperties.Name="退出预览" ToolTipService.ToolTip="退出预览（Esc）">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>
                    <Button x:Name="PreviewSortButton" Style="{StaticResource PreviewFlatButton}" HorizontalAlignment="Right"
                            AutomationProperties.Name="文件排序" ToolTipService.ToolTip="文件排序" />
                    <Grid x:Name="PreviewFilename" HorizontalAlignment="Center" VerticalAlignment="Center"
                          DoubleTapped="CopyPreviewFilename" ToolTipService.ToolTip="双击复制文件名">
                        <TextBlock x:Name="PreviewTitle" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                   FontWeight="SemiBold" AutomationProperties.HelpText="双击复制文件名" />
                        <StackPanel x:Name="PreviewCopyFeedback" Visibility="Collapsed" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="已复制" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="PreviewWorkspace" Grid.Row="1" SizeChanged="PreviewWorkspaceSizeChanged"
                      GotFocus="WorkPaneGotFocus">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="WorkPhotoColumn" Width="0*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="WorkVideoPane" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="PreviewCanvas" IsTabStop="True" PointerPressed="FocusWorkVideo"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="预览画布">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="PreviewTopRail" Height="36" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition x:Name="PreviewBottomRail" Height="36" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="PreviewLeftRail" Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="PreviewRightRail" Width="44" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="NeighborTop" Grid.Column="1" Width="72" Height="28" Opacity=".20" Stretch="UniformToFill" />
                                <Image x:Name="NeighborLeft" Grid.Row="1" Width="32" Height="72" Opacity=".20" Stretch="UniformToFill" />
                                <Image x:Name="NeighborRight" Grid.Row="1" Grid.Column="2" Width="32" Height="72"
                                       Opacity=".20" Stretch="UniformToFill" />
                                <Image x:Name="NeighborBottom" Grid.Row="2" Grid.Column="1" Width="72" Height="28"
                                       Opacity=".20" Stretch="UniformToFill" />
                                <Border x:Name="PreviewStage" Grid.Row="1" Grid.Column="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                                    <Grid>
                                        <Image x:Name="MainImage" Stretch="Uniform" />
                                        <MediaPlayerElement x:Name="VideoSurface" Visibility="Collapsed" AreTransportControlsEnabled="False"
                                                            IsTabStop="False" IsHitTestVisible="False" Stretch="Uniform" />
                                        <TextBlock x:Name="PreviewError" Visibility="Collapsed"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="22" />
                                    </Grid>
                                </Border>
                                <Button x:Name="PreviewUp" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="MovePreviewUp" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向上切换媒体">
                                    <FontIcon Glyph="&#xE70E;" FontSize="18" />
                                </Button>
                                <Button x:Name="PreviewLeft" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="MovePreviewLeft" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向左切换媒体">
                                    <FontIcon Glyph="&#xE76B;" FontSize="18" />
                                </Button>
                                <Button x:Name="PreviewRight" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="MovePreviewRight" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向右切换媒体">
                                    <FontIcon Glyph="&#xE76C;" FontSize="18" />
                                </Button>
                                <Button x:Name="PreviewDown" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="MovePreviewDown" Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="向下切换媒体">
                                    <FontIcon Glyph="&#xE70D;" FontSize="18" />
                                </Button>
                            </Grid>
                        </ContentControl>

                        <StackPanel Grid.Row="1" Spacing="3">
                            <ContentControl x:Name="VideoControls" Visibility="Collapsed" IsTabStop="False"
                                            HorizontalContentAlignment="Stretch" MaxWidth="680">
                                <Grid x:Name="VideoControlBar" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                      CornerRadius="20" Padding="10,3" ColumnSpacing="7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="VideoBack" Content="−15 秒" Click="SeekVideoBack" Style="{StaticResource PreviewFlatButton}"
                                            AutomationProperties.Name="后退 15 秒" />
                                    <Button x:Name="PlayPause" Grid.Column="1" Content="播放" Click="TogglePlayback"
                                            Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="播放或暂停" />
                                    <Button x:Name="VideoForward" Grid.Column="2" Content="+15 秒" Click="SeekVideoForward"
                                            Style="{StaticResource PreviewFlatButton}" AutomationProperties.Name="前进 15 秒" />
                                    <TextBlock x:Name="TimeLabel" Grid.Column="3" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="Timeline" Grid.Column="4" Minimum="0" Maximum="1" StepFrequency=".25" SmallChange=".25"
                                            VerticalAlignment="Center" ValueChanged="Seek" AutomationProperties.Name="视频进度" />
                                    <TextBlock x:Name="DurationLabel" Grid.Column="5" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ToggleButton x:Name="VideoLock" Grid.Column="6" Click="ToggleVideoLock"
                                                  Content="未锁定" AutomationProperties.Name="锁定视频预览"
                                                  ToolTipService.ToolTip="锁定或解锁视频预览（Enter）" />
                                </Grid>
                            </ContentControl>
                            <Grid>
                                <TextBlock x:Name="PreviewHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="65,0" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock x:Name="IndexLabel" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                        <Border x:Name="WorkVideoAura" Grid.RowSpan="2" CornerRadius="12" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{StaticResource WorkAuraBrush}" />
                    </Grid>
                    <Grid x:Name="WorkPhotoPane" Grid.Column="1" Visibility="Collapsed" Padding="7"
                          CornerRadius="12" RowSpacing="6" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WorkPhotoGroupPicker" HorizontalAlignment="Stretch" MinWidth="0"
                                      SelectionChanged="WorkPhotoGroupChanged" AutomationProperties.Name="图片分组" />
                            <Button x:Name="WorkPhotoSortButton" Grid.Column="1" Style="{StaticResource PreviewFlatButton}"
                                    AutomationProperties.Name="图片排序" ToolTipService.ToolTip="图片排序" />
                        </Grid>
                        <ContentControl x:Name="WorkPhotoCanvas" Grid.Row="1" IsTabStop="True" UseSystemFocusVisuals="True"
                                        PointerPressed="FocusWorkPhoto" HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" AutomationProperties.Name="照片画布"
                                        AutomationProperties.HelpText="左右方向键翻页，上键聚焦分组，下键聚焦排序">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                                <Grid>
                                    <Image x:Name="WorkPhotoImage" Stretch="Uniform" />
                                    <TextBlock x:Name="WorkPhotoError" Visibility="Collapsed" TextWrapping="Wrap" Margin="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Grid>
                            </Border>
                        </ContentControl>
                        <Grid Grid.Row="2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WorkPhotoPrevious" Click="WorkPhotoPreviousClicked" Style="{StaticResource PreviewFlatButton}"
                                    AutomationProperties.Name="上一张照片" ToolTipService.ToolTip="上一张照片">
                                <FontIcon Glyph="&#xE76B;" FontSize="15" />
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="WorkPhotoName" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="WorkPhotoCount" FontSize="12" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="WorkPhotoNext" Grid.Column="2" Click="WorkPhotoNextClicked"
                                    Style="{StaticResource PreviewFlatButton}"
                                    AutomationProperties.Name="下一张照片" ToolTipService.ToolTip="下一张照片">
                                <FontIcon Glyph="&#xE76C;" FontSize="15" />
                            </Button>
                        </Grid>
                        <Border x:Name="WorkPhotoAura" Grid.RowSpan="3" Margin="-7" CornerRadius="12" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{StaticResource WorkAuraBrush}" />
                    </Grid>
                </Grid>
            </Grid>
            <Canvas x:Name="PreviewMotionLayer" Visibility="Collapsed" IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw">
                <Image x:Name="PreviewMotionImage" Stretch="Uniform" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
