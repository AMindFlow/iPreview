                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体列表"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False">
                            <ListView.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SystemColorHighlightColorBrush" />
                                            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                                            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SystemColorHighlightColorBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="SystemColorHighlightTextColorBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                                            <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="29" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{StaticResource DetailRowPadding}" MinHeight="29" ColumnSpacing="10" CornerRadius="6"
                                          Background="{Binding RowBackground}" ToolTipService.ToolTip="{Binding DisplayPath}"
                                          Loaded="LoadListDetails" DataContextChanged="UpdateListDetails"
                                          PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource DetailNameWidth}" />
                                            <ColumnDefinition Width="{StaticResource DetailModifiedWidth}" MaxWidth="{StaticResource DetailModifiedMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailSizeWidth}" MaxWidth="{StaticResource DetailSizeMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailKindWidth}" MaxWidth="{StaticResource DetailKindMaximum}" />
                                            <ColumnDefinition Width="{StaticResource DetailSelectionWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="18" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="3">
                                                <Image Stretch="UniformToFill" Loaded="LoadThumbnail"
                                                       DataContextChanged="UpdateThumbnail" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Details.Modified}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details.Size}"
                                                   FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Kind}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource AlbumSelectionMark}"
                                                        Visibility="{Binding AlbumRemovalTickVisibility}" IsHitTestVisible="False"
                                                        IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid x:Name="FilmstripPane" Visibility="Collapsed" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="12">
                            <Grid>
                                <Image x:Name="FilmstripImage" Stretch="Uniform" />
                                <TextBlock x:Name="FilmstripMessage" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ListView x:Name="Filmstrip" Grid.Row="1" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                                  SingleSelectionFollowsFocus="True"
                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="画廊缩略图"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="0,0,2,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="88" RowSpacing="3" ToolTipService.ToolTip="{Binding DisplayPath}" Background="Transparent"
                                          PointerPressed="AlbumAdjustmentPointerPressed" Tapped="AlbumAdjustmentTapped">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="58" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="5">
                                            <Grid>
                                                <Image Stretch="UniformToFill" Loaded="LoadThumbnail"
                                                       DataContextChanged="UpdateThumbnail" />
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AlbumSelectionMark}"
                                                                Visibility="{Binding AlbumRemovalTickVisibility}" IsHitTestVisible="False"
                                                                IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <GridView x:Name="SourceFolders" Visibility="Collapsed" SelectionMode="Single"
                              IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="True" ItemClick="OpenSourceFolder"
                              PreviewKeyDown="SourceFoldersKeyDown" SizeChanged="CardGridSizeChanged"
                              ContainerContentChanging="CardContainerChanging"
                              ItemContainerStyle="{StaticResource LibraryCardStyle}" AutomationProperties.Name="创作者与专辑">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="200" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            Loaded="LoadFolderCover" DataContextChanged="UpdateFolderCover" />
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{Binding Caption}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <StackPanel x:Name="EmptyAlbumPicker" Visibility="Collapsed" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="EmptyAlbumAddButton" Click="PickAlbumMedia" AutomationProperties.Name="添加媒体"
                                ToolTipService.ToolTip="添加媒体" Style="{StaticResource LibrarySubtleButton}"
                                HorizontalAlignment="Center" Padding="4" BorderThickness="1.5">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="SubtleButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="SubtleButtonBorderBrushPointerOver" ResourceKey="AccentFillColorDefaultBrush" />
                                            <StaticResource x:Key="SubtleButtonBorderBrushPressed" ResourceKey="AccentFillColorDefaultBrush" />
                                            <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="ControlAltFillColorQuarternaryBrush" />
                                            <StaticResource x:Key="SubtleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="SubtleButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="SubtleButtonBorderBrushPointerOver" ResourceKey="AccentFillColorDefaultBrush" />
                                            <StaticResource x:Key="SubtleButtonBorderBrushPressed" ResourceKey="AccentFillColorDefaultBrush" />
                                            <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="ControlAltFillColorQuarternaryBrush" />
                                            <StaticResource x:Key="SubtleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="SubtleButtonForeground" ResourceKey="SystemColorButtonTextColorBrush" />
                                            <StaticResource x:Key="SubtleButtonBorderBrushPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                                            <StaticResource x:Key="SubtleButtonBorderBrushPressed" ResourceKey="SystemColorHighlightColorBrush" />
                                            <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
                                            <StaticResource x:Key="SubtleButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <Grid Width="66" Height="66">
                                <FontIcon Glyph="&#xE8B7;" FontSize="40" />
                                <FontIcon Glyph="&#xE710;" FontSize="15"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
                            </Grid>
                        </Button>
                        <TextBlock Text="合集为空" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyLabel" Text="导入文件夹后，图片和视频会显示在这里。"
                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Canvas x:Name="AlbumDragLayer" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                        <Rectangle x:Name="AlbumDropPlaceholder" RadiusX="7" RadiusY="7" Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                   Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="5,4" Visibility="Collapsed" />
                        <Border x:Name="AlbumDragAvatar" CornerRadius="7" BorderThickness="1"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                Opacity="0.96" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="AlbumDragCaption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="10,0" TextTrimming="CharacterEllipsis" />
                                <Image x:Name="AlbumDragImage" Stretch="Fill" />
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>

            </Grid>
        </Grid>
        </ContentControl>

        <Grid x:Name="SearchOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle"
              PreviewKeyDown="SearchKeyDown" AutomationProperties.Name="搜索">
            <Border Background="#2E000000" Tapped="DismissSearchFromBackdrop" />
            <Border MaxWidth="585" Margin="22" VerticalAlignment="Center" CornerRadius="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <StackPanel Spacing="8" Padding="17,13,17,12">
                    <Grid ColumnSpacing="9" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="SearchInput" Grid.Column="1" PlaceholderText="搜索所有媒体源"
