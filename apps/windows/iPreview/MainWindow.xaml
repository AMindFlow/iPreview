<Window x:Class="IPreview.MainWindow" Title="iPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid x:Name="LibraryView" PreviewKeyDown="LibraryKeyDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#CDE8EBF3" Padding="12,17,12,14" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TreeView x:Name="NavTree" Grid.RowSpan="2" SelectionMode="Single" ItemInvoked="Navigate"
                          PreviewKeyDown="NavigationTreeKeyDown" />
                <StackPanel Grid.Row="2" Spacing="6">
                    <Button x:Name="CreateAlbumButton" Click="CreateAlbum" HorizontalAlignment="Stretch" AutomationProperties.Name="新建虚拟专辑">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="新建专辑" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="Rescan" HorizontalAlignment="Stretch" Click="RescanSources">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="重新扫描" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="#F4F5F7" Padding="24,17,24,16" RowSpacing="13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid RowSpacing="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackToSourceFolder" Click="GoBackToSourceFolder" Visibility="Collapsed"
                                VerticalAlignment="Top" Margin="0,2,9,0"
                                AutomationProperties.Name="返回上一层" ToolTipService.ToolTip="返回上一层">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="Heading" Text="媒体库" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#18202D" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CountLabel" Foreground="#576375" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" MaxWidth="236" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="Query" MinWidth="0" QueryIcon="Find" PlaceholderText="搜索目录或文件名"
                                        QuerySubmitted="SearchSubmitted" TextChanged="SearchEdited" AutomationProperties.Name="搜索媒体库" />
                        <Button Grid.Column="1" ToolTipService.ToolTip="搜索选项" AutomationProperties.Name="搜索选项">
                            <FontIcon Glyph="&#xE71C;" FontSize="16" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="9" MinWidth="150">
                                        <ComboBox x:Name="SearchMode" SelectedIndex="1" SelectionChanged="ChangeSearchMode"
                                                  AutomationProperties.Name="搜索精确度" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="精确" />
                                            <ComboBoxItem Content="模糊" />
                                        </ComboBox>
                                        <CheckBox x:Name="SearchFolders" Content="目录" IsChecked="True" Click="ChangeSearchScope" />
                                        <CheckBox x:Name="SearchFiles" Content="文件" IsChecked="True" Click="ChangeSearchScope" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ImportButton" Grid.Column="2" Click="ChooseSource" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="导入文件夹">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="导入" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="ViewModePicker" Grid.Column="4" SelectedIndex="0" SelectionChanged="ChangeBrowseMode"
                                  AutomationProperties.Name="浏览视图" ToolTipService.ToolTip="浏览视图">
                            <ComboBoxItem Content="图标" />
                            <ComboBoxItem Content="列表" />
                            <ComboBoxItem Content="画廊" />
                        </ComboBox>
                    </Grid>
                </Grid>

                <InfoBar x:Name="Notice" Grid.Row="1" IsClosable="True" />
                <Grid Grid.Row="2">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="MediaSelectionFill" Color="{StaticResource SystemAccentColorDark1}" />
                                    <SolidColorBrush x:Key="MediaSelectionOutline" Color="#576783" />
                                    <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="MediaSelectionFill" />
                                    <StaticResource x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" ResourceKey="MediaSelectionFill" />
                                    <StaticResource x:Key="ListViewItemCheckBoxSelectedPressedBrush" ResourceKey="MediaSelectionFill" />
                                    <StaticResource x:Key="ListViewItemCheckBoxBorderBrush" ResourceKey="MediaSelectionOutline" />
                                    <StaticResource x:Key="ListViewItemCheckBoxPointerOverBorderBrush" ResourceKey="MediaSelectionOutline" />
                                    <StaticResource x:Key="ListViewItemCheckBoxPressedBorderBrush" ResourceKey="MediaSelectionOutline" />
                                    <StaticResource x:Key="GridViewItemCheckBoxSelectedBrush" ResourceKey="MediaSelectionFill" />
                                    <StaticResource x:Key="GridViewItemCheckBoxSelectedPointerOverBrush" ResourceKey="MediaSelectionFill" />
                                    <StaticResource x:Key="GridViewItemCheckBoxSelectedPressedBrush" ResourceKey="MediaSelectionFill" />
                                    <StaticResource x:Key="GridViewItemCheckBoxBorderBrush" ResourceKey="MediaSelectionOutline" />
                                    <StaticResource x:Key="GridViewItemCheckBoxPointerOverBorderBrush" ResourceKey="MediaSelectionOutline" />
                                    <StaticResource x:Key="GridViewItemCheckBoxPressedBorderBrush" ResourceKey="MediaSelectionOutline" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Grid.Resources>
                    <GridView x:Name="Gallery" SelectionMode="Single" Margin="-5,0" Padding="0,0,4,0"
                              DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                              SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体项目">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="274" ItemHeight="207" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="256" Height="193" RowSpacing="5" ToolTipService.ToolTip="{Binding DisplayPath}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="168" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#E4EAF4" CornerRadius="12">
                                        <Grid>
                                            <Image Stretch="UniformToFill" Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                                            <Border Visibility="{Binding BadgeVisibility}" Background="#B018202D"
                                                    Padding="7,3" CornerRadius="8" Margin="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" Foreground="#374458" FontSize="12"
                                               Margin="4,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Grid x:Name="DetailsPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="10,0,16,0" MinHeight="28" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="修改日期" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="大小" FontWeight="SemiBold" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="种类" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="Single" SingleSelectionFollowsFocus="True"
                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="媒体列表"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="29" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,0,16,0" MinHeight="29" ColumnSpacing="8"
                                          Background="{Binding RowBackground}" ToolTipService.ToolTip="{Binding DisplayPath}"
                                          Loaded="LoadListDetails" DataContextChanged="UpdateListDetails">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="20" Height="17" Background="#E4EAF4" CornerRadius="3">
                                                <Image Stretch="UniformToFill" Loaded="LoadThumbnail"
                                                       DataContextChanged="UpdateThumbnail" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Details.Modified}" Foreground="#576375"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details.Size}" Foreground="#576375"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Kind}" Foreground="#576375"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid x:Name="FilmstripPane" Visibility="Collapsed" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="#E7EBF2" CornerRadius="12" Padding="12">
                            <Grid>
                                <Image x:Name="FilmstripImage" Stretch="Uniform" />
                                <TextBlock x:Name="FilmstripMessage" Visibility="Collapsed" Foreground="#576375"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ListView x:Name="Filmstrip" Grid.Row="1" SelectionMode="Single" SingleSelectionFollowsFocus="True"
                                  DoubleTapped="PreviewDoubleTapped" PreviewKeyDown="GalleryKeyDown"
                                  SelectionChanged="SelectionChanged" AutomationProperties.Name="画廊缩略图"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="0,0,2,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="88" RowSpacing="3" ToolTipService.ToolTip="{Binding DisplayPath}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="58" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#E4EAF4" CornerRadius="5">
                                            <Image Stretch="UniformToFill" Loaded="LoadThumbnail"
                                                   DataContextChanged="UpdateThumbnail" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <ListView x:Name="SourceFolders" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OpenSourceFolder"
                              PreviewKeyDown="SourceFoldersKeyDown"
                              AutomationProperties.Name="创作者与专辑">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="2,9">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="#4C5B74"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{Binding Label}" FontSize="15" Foreground="#18202D" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyAlbumPicker" Visibility="Collapsed" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="EmptyAlbumAddButton" Click="PickAlbumMedia" AutomationProperties.Name="添加媒体"
                                ToolTipService.ToolTip="添加媒体" BorderThickness="0" Background="Transparent"
                                HorizontalAlignment="Center" Padding="4">
                            <Grid Width="66" Height="66">
                                <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="#576375" />
                                <Border Width="25" Height="25" CornerRadius="13" Background="#5274DF"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White" />
                                </Border>
                            </Grid>
                        </Button>
                        <TextBlock Text="专辑为空" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyLabel" Text="导入文件夹后，图片和视频会显示在这里。"
                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#576375" TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="3">
                    <StackPanel x:Name="BrowseTools" Orientation="Horizontal" Spacing="7">
                        <Button x:Name="OpenButton" Click="PreviewSelected" Content="预览" />
                        <Button x:Name="AddButton" Click="AddToAlbum" Content="加入专辑" />
                        <StackPanel x:Name="AlbumTools" Orientation="Horizontal" Spacing="7" Visibility="Collapsed">
                            <Button x:Name="AlbumPickerButton" Click="PickAlbumMedia" AutomationProperties.Name="添加媒体"
                                    ToolTipService.ToolTip="添加媒体" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Click="RenameAlbum" Content="重命名" />
                            <Button x:Name="MoveUpButton" Click="MoveEarlier" Content="上移" />
                            <Button x:Name="MoveDownButton" Click="MoveLater" Content="下移" />
                            <Button x:Name="RemoveButton" Click="RemoveFromAlbum" Content="移除引用" />
                            <Button x:Name="SelectAlbumMembersButton" Click="BeginAlbumSelection" Content="选择"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="AlbumSelectionTools" Orientation="Horizontal" Spacing="7" Visibility="Collapsed">
                        <TextBlock x:Name="AlbumSelectionCount" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="#576375" AutomationProperties.LiveSetting="Polite" />
                        <Button Click="CancelAlbumSelection" Content="取消" />
                        <Button x:Name="RemoveAlbumSelectionButton" Click="RemoveFromAlbum" Content="移除引用"
                                IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="PreviewOverlay" Visibility="Collapsed" Background="#FF10161F" RequestedTheme="Dark" Padding="24,12"
              RowSpacing="10" PreviewKeyDown="PreviewKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="ClosePreviewButton" AutomationProperties.Name="退出预览" ToolTipService.ToolTip="退出预览（Esc）">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <TextBlock x:Name="PreviewTitle" Grid.Column="1" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="IndexLabel" Grid.Column="2" Foreground="#B6C4C5" VerticalAlignment="Center" />
            </Grid>

            <ContentControl x:Name="PreviewCanvas" Grid.Row="1" IsTabStop="True"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="预览画布，方向键切换媒体，空格键关闭">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="112" />
                        <ColumnDefinition Width="8*" />
                        <ColumnDefinition Width="*" MaxWidth="112" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="NeighborTop" Grid.Column="1" Opacity=".32" Stretch="UniformToFill" />
                    <Image x:Name="NeighborLeft" Grid.Row="1" Opacity=".32" Stretch="UniformToFill" />
                    <Image x:Name="NeighborRight" Grid.Row="1" Grid.Column="2" Opacity=".32" Stretch="UniformToFill" />
                    <Image x:Name="NeighborBottom" Grid.Row="2" Grid.Column="1" Opacity=".32" Stretch="UniformToFill" />
                    <Border Grid.Row="1" Grid.Column="1" Background="#0C1317" CornerRadius="12">
                        <Grid>
                            <Image x:Name="MainImage" Stretch="Uniform" />
                            <MediaPlayerElement x:Name="VideoSurface" Visibility="Collapsed" AreTransportControlsEnabled="False" Stretch="Uniform" />
                            <TextBlock x:Name="PreviewError" Visibility="Collapsed" Foreground="#F0CEAE"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="22" />
                        </Grid>
                    </Border>
                </Grid>
            </ContentControl>

            <StackPanel Grid.Row="2" Spacing="9">
                <Grid x:Name="VideoControls" Visibility="Collapsed" Background="#253034"
                      HorizontalAlignment="Stretch" MaxWidth="640" CornerRadius="12" Padding="12,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPause" Content="播放" Click="TogglePlayback"
                            AutomationProperties.Name="播放或暂停" />
                    <TextBlock x:Name="TimeLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="#D2DEDE" />
                    <Slider x:Name="Timeline" Grid.Column="2" Minimum="0" Maximum="1" StepFrequency=".25"
                            VerticalAlignment="Center" ValueChanged="Seek" AutomationProperties.Name="视频进度" />
                </Grid>
                <TextBlock x:Name="PreviewHint" Foreground="#BCCBCB" HorizontalAlignment="Center" FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
