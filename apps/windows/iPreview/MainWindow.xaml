                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="194" ItemHeight="146" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="172" Spacing="7">
                            <Border Height="102" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Image DataContext="{Binding Cover}" Stretch="UniformToFill"
                                       Loaded="LoadThumbnail" DataContextChanged="UpdateThumbnail" />
                            </Border>
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
