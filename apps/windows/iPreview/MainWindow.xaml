                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <Button x:Name="SearchTagFilter" Grid.Column="3" CornerRadius="12"
                                AutomationProperties.Name="标签筛选" ToolTipService.ToolTip="标签筛选。输入 # 查询标签。" />
                        <Button Grid.Column="4" Click="CloseSearchButton" ToolTipService.ToolTip="关闭搜索（Esc）"
                                VerticalAlignment="Center" Width="32" Height="32" Padding="0" CornerRadius="12"
                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="关闭搜索">
                            <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="SearchStatus" Visibility="Collapsed" Margin="3,3,0,3"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ListView x:Name="SearchTagSuggestions" Visibility="Collapsed" MaxHeight="205" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="ChooseTagSuggestion" AutomationProperties.Name="标签联想">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="13" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="SearchResults" Visibility="Collapsed" MaxHeight="299" SelectionMode="Single"
                              SingleSelectionFollowsFocus="True" AutomationProperties.Name="搜索结果">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" Margin="8,4" FontWeight="SemiBold" FontSize="12"
                                                   AutomationProperties.HeadingLevel="Level2"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="9" MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="SearchFiles" Content="Ctrl+1 文件" Click="ResultKindClicked"
                                          CornerRadius="12" MinHeight="28" Padding="8,3"
                                          AutomationProperties.Name="仅搜索文件">
                                <ToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="ResultKindShortcut" />
                                </ToggleButton.KeyboardAccelerators>
                            </ToggleButton>
                            <ToggleButton x:Name="SearchDirectories" Grid.Column="1" Content="Ctrl+2 目录"
                                          CornerRadius="12" MinHeight="28" Padding="8,3"
                                          Click="ResultKindClicked" AutomationProperties.Name="仅搜索目录">
                                <ToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="ResultKindShortcut" />
                                </ToggleButton.KeyboardAccelerators>
                            </ToggleButton>
                            <Button x:Name="SearchDomain" Grid.Column="2" Content="Ctrl+0 全局"
                                    CornerRadius="12" MinHeight="28" Padding="8,3" Click="SwitchSearchDomainClick"
                                    AutomationProperties.Name="切换搜索范围">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="SwitchSearchDomainShortcut" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <TextBlock x:Name="SearchExactHint" Grid.Column="3" Text="输入 # 搜索标签 · @ 后按空格精确匹配"
                                       FontSize="12" Margin="6,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="SearchKeyHelp"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

