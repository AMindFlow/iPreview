                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="VideoWorkSortButton" Grid.Column="2" Visibility="Collapsed"
                        Style="{StaticResource LibraryIconButton}" AutomationProperties.Name="文件排序"
                        ToolTipService.ToolTip="文件排序">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                </Button>
            </Grid>
            <GridView x:Name="VideoWorkItems" Grid.Row="1" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
