                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="关闭搜索">
                            <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="SearchStatus" Visibility="Collapsed" Margin="3,3,0,3"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ListView x:Name="SearchTagSuggestions" Visibility="Collapsed" MaxHeight="205" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="ChooseTagSuggestion" AutomationProperties.Name="标签联想">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="13" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="SearchResults" Visibility="Collapsed" MaxHeight="299" SelectionMode="Single"
                              SingleSelectionFollowsFocus="True" AutomationProperties.Name="搜索结果">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" Margin="8,4" FontWeight="SemiBold" FontSize="12"
