                        </Border>
                        <Button x:Name="SearchTagStack" Grid.Column="3" CornerRadius="9" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Visibility="Collapsed" VerticalAlignment="Center" Click="OpenSearchTags" PointerEntered="PeekSearchTags">
                            <Grid>
                                <Border x:Name="SearchTagRearCard" CornerRadius="7" Margin="10,8,0,0"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" BorderThickness="1"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="SearchTagMiddleCard" CornerRadius="7" Margin="5,4,0,0"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" BorderThickness="1"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="SearchTagFrontCard" CornerRadius="7" Padding="7,3"
                                        Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="13" />
                                        <TextBlock x:Name="SearchTagName" MaxWidth="76" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <FlyoutBase.AttachedFlyout>
                                <Flyout x:Name="SearchTagsFlyout" Placement="BottomEdgeAlignedRight">
                                    <ScrollViewer MaxHeight="220" MinWidth="160">
                                        <ItemsControl x:Name="SearchActiveTags">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" MinHeight="30" MaxWidth="240" Background="Transparent"
                                                          PointerEntered="TagChipEntered" PointerExited="TagChipExited">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE8EC;" FontSize="13" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button x:Name="RemoveTagButton" Grid.Column="2" Click="RemoveSearchTag"
                                                                Width="18" MinWidth="18" Height="18" MinHeight="18" Padding="0"
                                                                CornerRadius="9" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Opacity="0" IsHitTestVisible="False" Loaded="InitializeTagRemoveButton"
                                                                GotFocus="FocusTagRemoveButton" LostFocus="BlurTagRemoveButton"
                                                                Tag="移除标签筛选" ToolTipService.ToolTip="移除标签筛选">
                                                            <FontIcon Glyph="&#xE8BB;" FontSize="10"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <Button Grid.Column="4" Click="CloseSearchButton" ToolTipService.ToolTip="关闭搜索（Esc）"
