<UserControl
    x:Class="IPreview.AudioRecordDeck"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="PlinthBrush" StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="#2E3033" Offset="0" />
                        <GradientStop Color="#232427" Offset="0.55" />
                        <GradientStop Color="#1B1C1E" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlinthBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#494B50" Offset="0" />
                        <GradientStop Color="#121315" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlatterRimBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A3C40" Offset="0" />
                        <GradientStop Color="#1A1B1D" Offset="0.5" />
                        <GradientStop Color="#2E3034" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="TonearmBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A4A7AC" Offset="0" />
                        <GradientStop Color="#EAECEF" Offset="0.45" />
                        <GradientStop Color="#6D7075" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PivotBaseBrush" Color="#1F2023" />
                    <SolidColorBrush x:Key="HeadshellBrush" Color="#26282B" />
                    <SolidColorBrush x:Key="KnobAccentBrush" Color="#C98E63" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="PlinthBrush" StartPoint="0,0" EndPoint="1,0.15">
                        <GradientStop Color="#EAE4DC" Offset="0" />
                        <GradientStop Color="#DDD6CD" Offset="0.5" />
                        <GradientStop Color="#E6E0D7" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlinthBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6F2EC" Offset="0" />
                        <GradientStop Color="#BFB7AD" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlatterRimBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E2DBD1" Offset="0" />
                        <GradientStop Color="#A8A198" Offset="0.5" />
                        <GradientStop Color="#D6CFC5" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="TonearmBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C9C2B8" Offset="0" />
                        <GradientStop Color="#F2EEE8" Offset="0.45" />
                        <GradientStop Color="#8E877E" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PivotBaseBrush" Color="#C2BBB1" />
                    <SolidColorBrush x:Key="HeadshellBrush" Color="#8F887F" />
                    <SolidColorBrush x:Key="KnobAccentBrush" Color="#3E8E7E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <LinearGradientBrush x:Key="VinylBaseBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#16171A" Offset="0" />
                <GradientStop Color="#08090A" Offset="0.5" />
                <GradientStop Color="#131417" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="VinylSheenBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#00FFFFFF" Offset="0.22" />
                <GradientStop Color="#2BFFFFFF" Offset="0.42" />
                <GradientStop Color="#05FFFFFF" Offset="0.5" />
                <GradientStop Color="#24FFFFFF" Offset="0.58" />
                <GradientStop Color="#00FFFFFF" Offset="0.78" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="VinylCrossSheenBrush" StartPoint="0.9,0" EndPoint="0.1,1">
                <GradientStop Color="#00FFFFFF" Offset="0.34" />
                <GradientStop Color="#14FFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="0.66" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
        <Canvas Width="400" Height="360">
            <Border Canvas.Left="12" Canvas.Top="12" Width="376" Height="336" CornerRadius="26"
                    Background="{ThemeResource PlinthBrush}" BorderBrush="{ThemeResource PlinthBorderBrush}" BorderThickness="1.5" />
            <Ellipse Canvas.Left="30" Canvas.Top="36" Width="288" Height="288" Fill="{ThemeResource PlatterRimBrush}" />
            <Ellipse Canvas.Left="36" Canvas.Top="42" Width="276" Height="276" Fill="{StaticResource VinylBaseBrush}" />
            <Ellipse Canvas.Left="36" Canvas.Top="42" Width="276" Height="276" Fill="{StaticResource VinylSheenBrush}" />
            <Ellipse Canvas.Left="36" Canvas.Top="42" Width="276" Height="276" Fill="{StaticResource VinylCrossSheenBrush}" />
            <Ellipse Canvas.Left="46" Canvas.Top="52" Width="256" Height="256" Stroke="#22FFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="58" Canvas.Top="64" Width="232" Height="232" Stroke="#1CFFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="70" Canvas.Top="76" Width="208" Height="208" Stroke="#20FFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="82" Canvas.Top="88" Width="184" Height="184" Stroke="#18FFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="94" Canvas.Top="100" Width="160" Height="160" Stroke="#20FFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="106" Canvas.Top="112" Width="136" Height="136" Stroke="#18FFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="114" Canvas.Top="120" Width="120" Height="120" Fill="#0C0D0F" Stroke="#26FFFFFF" StrokeThickness="0.8" />
            <Ellipse Canvas.Left="120" Canvas.Top="126" Width="108" Height="108" Fill="#202226" />
            <Ellipse Canvas.Left="120" Canvas.Top="126" Width="108" Height="108" Stroke="#33FFFFFF" StrokeThickness="1">
                <Ellipse.Fill>
                    <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="165" Canvas.Top="171" Width="18" Height="18" Fill="{ThemeResource TonearmBrush}" Stroke="#55000000" StrokeThickness="1" />
            <Ellipse Canvas.Left="170" Canvas.Top="176" Width="8" Height="8" Fill="#44FFFFFF" />
            <Ellipse Canvas.Left="323" Canvas.Top="279" Width="38" Height="38" Stroke="{ThemeResource KnobAccentBrush}" StrokeThickness="1.5" StrokeDashArray="10 40" StrokeDashOffset="22" />
            <Ellipse Canvas.Left="327" Canvas.Top="283" Width="30" Height="30" Fill="{ThemeResource PivotBaseBrush}" Stroke="{ThemeResource PlinthBorderBrush}" StrokeThickness="1.2" />
            <Ellipse Canvas.Left="304" Canvas.Top="46" Width="56" Height="56" Fill="{ThemeResource PivotBaseBrush}" Stroke="{ThemeResource PlinthBorderBrush}" StrokeThickness="1.2" />
            <Ellipse Canvas.Left="313" Canvas.Top="55" Width="38" Height="38" Stroke="#33FFFFFF" StrokeThickness="1" Fill="#1A000000" />
            <Canvas x:Name="Tonearm" Width="400" Height="360">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="TonearmRotate" CenterX="332" CenterY="74" Angle="0" />
                </Canvas.RenderTransform>
                <Border Canvas.Left="324" Canvas.Top="42" Width="18" Height="22" CornerRadius="4" Background="{ThemeResource TonearmBrush}" BorderBrush="#44000000" BorderThickness="1" />
                <Path Data="M 332,74 L 323,186 Q 320,210 307,232" Stroke="#55000000" StrokeThickness="7.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="2" Canvas.Top="3" />
                <Path Data="M 332,74 L 323,186 Q 320,210 307,232" Stroke="{ThemeResource TonearmBrush}" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Border Canvas.Left="297" Canvas.Top="224" Width="14" Height="26" CornerRadius="3" Background="{ThemeResource HeadshellBrush}" BorderBrush="#44FFFFFF" BorderThickness="0.8">
                    <Border.RenderTransform>
                        <RotateTransform CenterX="7" CenterY="13" Angle="30" />
                    </Border.RenderTransform>
                </Border>
                <Ellipse Canvas.Left="295" Canvas.Top="246" Width="4" Height="4" Fill="#D4A662" />
                <Ellipse Canvas.Left="321" Canvas.Top="63" Width="22" Height="22" Fill="{ThemeResource TonearmBrush}" Stroke="#44000000" StrokeThickness="1" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
