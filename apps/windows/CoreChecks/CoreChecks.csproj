<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../iPreview/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../shared/migrations/001-initial.sql"
                      LogicalName="iPreview.Migrations.001-initial.sql" />
    <EmbeddedResource Include="../../../shared/migrations/002-pending-rename.sql"
                      LogicalName="iPreview.Migrations.002-pending-rename.sql" />
    <EmbeddedResource Include="../../../shared/migrations/003-album-organization.sql"
                      LogicalName="iPreview.Migrations.003-album-organization.sql" />
    <EmbeddedResource Include="../../../shared/migrations/004-video-works.sql"
                      LogicalName="iPreview.Migrations.004-video-works.sql" />
    <EmbeddedResource Include="../../../shared/migrations/005-source-media-identities.sql"
                      LogicalName="iPreview.Migrations.005-source-media-identities.sql" />
  </ItemGroup>
</Project>
